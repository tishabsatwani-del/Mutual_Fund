{
  "$comment": [
    "The state system of Build Specification v2, section 7.3. Every interpretive",
    "sentence in the Where You Stand report is selected by an exact arithmetic",
    "condition, and this file holds those conditions' thresholds and the fixed",
    "mapping from active states to next steps (section 7.5).",
    "",
    "It carries identifiers and numbers only. No prose lives here: each state",
    "names the copy.json slot whose sentence the author writes.",
    "",
    "The thresholds below are the values the specification states. They are set",
    "once by the author and then frozen (section 19, item 4); until that sign-off",
    "arrives, signedOff stays false and the build will say so."
  ],
  "version": 1,
  "signedOff": false,
  "thresholds": {
    "earlySpanDays": 365,
    "staleAfterDays": 30,
    "gapPoints": 2.0,
    "altPoints": 1.0,
    "stretchLowPercentile": 25,
    "stretchHighPercentile": 75,
    "stretchMinWindows": 30,
    "stretchMinExtraDays": 365
  },
  "sections": [
    {
      "id": "report",
      "states": [
        { "id": "S-EARLY", "slot": "POS-TOO-EARLY", "suppressesAnnualised": true },
        { "id": "S-FULL", "slot": null }
      ]
    },
    {
      "id": "fundStatus",
      "states": [
        { "id": "S-STALE", "slot": "POS-STALE", "presentation": "banner" },
        { "id": "S-LIVE", "slot": null }
      ]
    },
    {
      "id": "gap",
      "states": [
        { "id": "S-GAP-BEHIND", "slot": "POS-GAP-BEHIND" },
        { "id": "S-GAP-AHEAD", "slot": "POS-GAP-AHEAD" },
        { "id": "S-GAP-NEUTRAL", "slot": "POS-GAP-NEUTRAL" }
      ]
    },
    {
      "id": "stretch",
      "states": [
        { "id": "S-STRETCH-NA", "slot": "POS-STRETCH-NA" },
        { "id": "S-STRETCH-LOW", "slot": "POS-STRETCH-LOW" },
        { "id": "S-STRETCH-HIGH", "slot": "POS-STRETCH-HIGH" },
        { "id": "S-STRETCH-MID", "slot": "POS-STRETCH-MID" }
      ]
    },
    {
      "id": "alternative",
      "states": [
        { "id": "S-ALT-NONE", "slot": "POS-ALT-NONE" },
        { "id": "S-ALT-BEHIND", "slot": "POS-ALT-BEHIND" },
        { "id": "S-ALT-AHEAD", "slot": "POS-ALT-AHEAD" },
        { "id": "S-ALT-CLOSE", "slot": "POS-ALT-CLOSE" }
      ]
    }
  ],
  "nextSteps": {
    "$comment": [
      "Section 7.5. At most three are shown, taken in the order the sections are",
      "evaluated. Every step is either an in-Simulator action that opens another",
      "mode pre-filled, or a pointer into the book through the [CH-REF] token",
      "convention resolved from copy.json. No step links outside the Simulator",
      "and no step carries a transaction instruction."
    ],
    "S-EARLY": [
      { "id": "NEXT-SHORT-PERIOD", "kind": "book", "ref": "[CH-REF:SHORT-PERIOD]", "labelSlot": "POS-NEXT-SHORT-PERIOD" }
    ],
    "S-STALE": [
      { "id": "NEXT-STALE-RECORD", "kind": "action", "labelSlot": "POS-NEXT-STALE-RECORD",
        "target": { "module": "B", "fund": "current", "range": "max" } }
    ],
    "S-GAP-BEHIND": [
      { "id": "NEXT-GAP-TIMING", "kind": "book", "ref": "[CH-REF:INSTALMENT-TIMING]", "labelSlot": "POS-NEXT-GAP-TIMING" }
    ],
    "S-GAP-AHEAD": [
      { "id": "NEXT-GAP-TIMING", "kind": "book", "ref": "[CH-REF:INSTALMENT-TIMING]", "labelSlot": "POS-NEXT-GAP-TIMING" }
    ],
    "S-GAP-NEUTRAL": [],
    "S-STRETCH-LOW": [
      { "id": "NEXT-EVERY-STRETCH", "kind": "action", "labelSlot": "POS-NEXT-EVERY-STRETCH",
        "target": { "module": "B", "fund": "current", "window": "visitor-span" } }
    ],
    "S-STRETCH-HIGH": [
      { "id": "NEXT-EVERY-STRETCH", "kind": "action", "labelSlot": "POS-NEXT-EVERY-STRETCH",
        "target": { "module": "B", "fund": "current", "window": "visitor-span" } }
    ],
    "S-STRETCH-MID": [
      { "id": "NEXT-EVERY-STRETCH", "kind": "action", "labelSlot": "POS-NEXT-EVERY-STRETCH",
        "target": { "module": "B", "fund": "current", "window": "visitor-span" } }
    ],
    "S-STRETCH-NA": [
      { "id": "NEXT-FULL-RECORD", "kind": "action", "labelSlot": "POS-NEXT-FULL-RECORD",
        "target": { "module": "B", "fund": "current", "range": "max" } }
    ],
    "S-ALT-NONE": [],
    "S-ALT-BEHIND": [
      { "id": "NEXT-OVERLAY", "kind": "action", "labelSlot": "POS-NEXT-OVERLAY",
        "target": { "module": "B", "fund": "current", "benchmark": "on" } }
    ],
    "S-ALT-AHEAD": [
      { "id": "NEXT-OVERLAY", "kind": "action", "labelSlot": "POS-NEXT-OVERLAY",
        "target": { "module": "B", "fund": "current", "benchmark": "on" } }
    ],
    "S-ALT-CLOSE": [
      { "id": "NEXT-OVERLAY", "kind": "action", "labelSlot": "POS-NEXT-OVERLAY",
        "target": { "module": "B", "fund": "current", "benchmark": "on" } }
    ]
  },
  "maxNextSteps": 3
}
